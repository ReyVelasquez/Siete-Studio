# =============================================================================
# SIETE STICKER STUDIO - Frontend Environment Configuration
# Copy this file to .env and fill in your Firebase Web App & API URL.
# NEVER commit .env with real production secrets.
# =============================================================================

# Backend FastAPI Base URL (without trailing slash)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Firebase Web SDK Configuration (Project Settings -> Your Apps -> Web App)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
