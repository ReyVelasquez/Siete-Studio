# =============================================================================
# SIETE STICKER STUDIO - Backend Environment Configuration
# Copy this file to .env and replace placeholder values. NEVER commit .env.
# =============================================================================

# Application
APP_NAME="Siete Sticker Studio API"
APP_ENV=development
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Strict CORS (comma-separated list of allowed origins, NO trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Relational Database (PostgreSQL recommended via SQLAlchemy 2.0)
# PostgreSQL example:
# DATABASE_URL=postgresql+psycopg://postgres:tu_password@localhost:5432/siete_studio
# Local zero-setup relational fallback (enforces FK + CHECK constraints via SQLite):
DATABASE_URL=sqlite:///./siete_studio.db

# Optional: first admin email automatically promoted to 'admin' role on login
INITIAL_ADMIN_EMAIL=

# Firebase Admin SDK
# Option A (recommended for local dev): absolute or relative path to the service account JSON file
FIREBASE_CREDENTIALS_PATH=./firebase-service-account.json
# Option B (recommended for containers/cloud): single-line JSON string OR Base64-encoded JSON
# FIREBASE_CREDENTIALS_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Storage driver: "firebase" (strict), "auto" (Firebase Storage if bucket exists, else secure local fallback), "local"
STORAGE_BACKEND=auto

# Business Rules & Limits
MAX_UPLOAD_SIZE_MB=10
DELIVERY_HOUR_START=8
DELIVERY_HOUR_END=20
TIMEZONE_OFFSET_MINUTES=-240

# Rate Limiting (Public Order Creation Endpoint)
RATE_LIMIT_PUBLIC_ORDERS_REQUESTS=10
RATE_LIMIT_PUBLIC_ORDERS_WINDOW_SECONDS=60
TRUST_PROXY_HEADERS=false

# =============================================================================
# RECOMMENDED PRODUCTION CONFIGURATION (Railway / Render + Neon / Supabase)
# =============================================================================
# APP_ENV=production
# APP_DEBUG=false
# CORS_ORIGINS=https://tu-frontend.vercel.app
# DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
#   (Nota: postgres:// y postgresql:// se normalizan automáticamente a postgresql+psycopg://)
# INITIAL_ADMIN_EMAIL=admin@tu-dominio.com
# FIREBASE_CREDENTIALS_PATH=
# FIREBASE_CREDENTIALS_JSON=<JSON en una sola línea o codificado en Base64>
# FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# STORAGE_BACKEND=firebase
# TRUST_PROXY_HEADERS=true
